<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Air Pollution AQI Predictions</name>
    <description>Air quality classification mapped with coordinates. Green = Safe, Red = Polluted.</description>
    
    <!-- Style for Safe Air (Green Paddle) -->
    <Style id="safe_style">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.0</scale> <!-- Hide label by default unless hovered -->
      </LabelStyle>
    </Style>

    <!-- Style for Polluted Air (Red Paddle) -->
    <Style id="polluted_style">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.0</scale>
      </LabelStyle>
    </Style>
    <Placemark>
      <name>Safe (AQI: 100)</name>
      <description><![CDATA[
        <h3>Air Quality Report 🟢</h3>
        <p><b>Status:</b> Safe</p>
        <p><b>AQI Value:</b> 100</p>
        <p><b>Pollution Probability:</b> 1.91%</p>
        <p><b>Coordinates:</b> 12.83192, 77.51627</p>
      ]]></description>
      <styleUrl>#safe_style</styleUrl>
      <Point>
        <coordinates>77.51626990148995,12.831916521624224,0</coordinates>
      </Point>
    </Placemark>
